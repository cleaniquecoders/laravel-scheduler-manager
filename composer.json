{
    "name": "cleaniquecoders/laravel-scheduler-manager",
    "description": "Manage scheduler from config and GUI",
    "keywords": [
        "Cleanique Coders",
        "laravel",
        "laravel-scheduler-manager"
    ],
    "homepage": "https://github.com/cleaniquecoders/laravel-scheduler-manager",
    "license": "MIT",
    "authors": [
        {
            "name": "Nasrul Hazim Bin Mohamad",
            "email": "nasrulhazim.m@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "cleaniquecoders/traitify": "^1.4",
        "dragonmantank/cron-expression": "^3.4",
        "illuminate/contracts": "^12.0||^13.0",
        "livewire/flux": "^2.17",
        "livewire/livewire": "^3.7",
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8||^8.0",
        "orchestra/testbench": "^10.0.0||^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CleaniqueCoders\\LaravelSchedulerManager\\": "src/",
            "CleaniqueCoders\\LaravelSchedulerManager\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CleaniqueCoders\\LaravelSchedulerManager\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CleaniqueCoders\\LaravelSchedulerManager\\LaravelSchedulerManagerServiceProvider"
            ],
            "aliases": {
                "LaravelSchedulerManager": "CleaniqueCoders\\LaravelSchedulerManager\\Facades\\LaravelSchedulerManager"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
